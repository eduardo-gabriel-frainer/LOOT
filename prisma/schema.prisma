generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model games {
  id        Int      @id @default(autoincrement())
  appid     Int      @unique(map: "Game_appId_key")
  name      String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}
